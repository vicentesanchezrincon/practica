# Copia este fichero a .env y ajusta los valores. .env esta en .gitignore.

# --- Postgres local (docker-compose) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=practica
POSTGRES_PASSWORD=practica_local_only

# Desde el host (fuera de docker) usa localhost en vez de "postgres"
# POSTGRES_HOST=localhost

# --- AWS (solo a partir de la Fase 2) ---
AWS_REGION=eu-west-1
AWS_PROFILE=default

# Entorno de despliegue: dev | prod
ENVIRONMENT=dev
